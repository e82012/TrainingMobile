# Google Gemini API 金鑰（可由 Google AI Studio 免費取得）
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets ID（由 Google 試算表網址中的 /d/ 後方那一長串字串）
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Cloud Service Account 憑證（若尚未設定，系統會自動以 Demo 模式運作）
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"
