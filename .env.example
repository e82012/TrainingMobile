# Google Gemini API 金鑰（可由 Google AI Studio 取得）
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 模型名稱（選填，預設 gemini-2.5-flash）
# GEMINI_MODEL=gemini-2.5-flash

# Google Sheets ID（由 Google 試算表網址中的 /d/ 後方那一長串字串）
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Cloud Service Account 憑證（必填，未設定時無法讀寫試算表）
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# 入口密碼（必填）：未設定時所有頁面與 API 一律拒絕存取；登入後當日（台北時間）有效
APP_PASSWORD=your_entry_password_here
